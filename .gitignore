# Root-level ignores only — each server package has its own .gitignore
# for its build/output/env artifacts (node_modules/, dist/, .env, etc.).
.DS_Store
Thumbs.db
*.log
.idea/

# Shared monorepo API key location (both servers load it; a package .env wins).
# Explicit patterns, not a bare `.env*`, so `.env.example` files stay trackable.
.env
.env.local
.env.*.local
