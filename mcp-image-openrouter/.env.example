# ── OpenRouter MCP image server — environment configuration ──────────────────
# Copy to `.env` for local dev/testing:  cp .env.example .env
# dotenv is non-overriding: any var already set by the MCP client wins (D10).
# For Claude Desktop, prefer setting these in claude_desktop_config.json instead.

# REQUIRED — your OpenRouter API key (https://openrouter.ai/keys). Starts with "sk-or-".
# The real key is added manually only when reaching the live-testing stage; unit
# tests mock the SDK and do not need it.
OPENROUTER_API_KEY=

# ── Models (verified 2026-07-11, see docs/OPENROUTER_API.md §4) ───────────────
# Stage-1 prompt-enhancement (text) model.
OPENROUTER_TEXT_MODEL=google/gemini-3.5-flash
# Image model for the `fast` / `balanced` quality tiers.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Image model for the `quality` tier (falls back to OPENROUTER_IMAGE_MODEL if unset).
OPENROUTER_IMAGE_MODEL_HQ=google/gemini-3-pro-image

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the OpenRouter base URL (default below).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution for OpenRouter rankings (HTTP-Referer / X-Title).
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=
# Output directory for generated images. Use an ABSOLUTE path for Claude Desktop.
# IMAGE_OUTPUT_DIR=./output
# Default quality preset: fast | balanced | quality
# IMAGE_QUALITY=fast
# Skip Stage-1 prompt enhancement and send the prompt straight to the image model.
# SKIP_PROMPT_ENHANCEMENT=false
# Attach a small downscaled image preview inline in the tool response so MCP clients
# (e.g. Claude Desktop) can render it. The full-resolution file is always saved to disk.
# Set to false for text/path-only responses. Default: true.
# IMAGE_INLINE_PREVIEW=true
