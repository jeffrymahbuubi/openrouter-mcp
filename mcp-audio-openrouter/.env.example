# ── OpenRouter MCP audio server — environment configuration ──────────────────
# Copy to `.env` for local dev/testing:  cp .env.example .env
# dotenv is non-overriding: any var already set by the MCP client wins.
# For Claude Desktop, prefer setting these in claude_desktop_config.json instead.

# REQUIRED — your OpenRouter API key (https://openrouter.ai/keys). Starts with "sk-or-".
# Unit tests mock the client and do not need it; only needed for the Phase 0
# API spike and for live/manual testing.
OPENROUTER_API_KEY=

# ── Models ──────────────────────────────────────────────────────────────────
# Voice-generation model (spoken dialogue/narration).
OPENROUTER_VOICE_MODEL=openai/gpt-audio
# Music-generation model for the "clip" length preset (~30s).
OPENROUTER_MUSIC_MODEL=google/lyria-3-clip-preview
# Music-generation model for the "long" length preset (up to a couple minutes).
# Falls back to OPENROUTER_MUSIC_MODEL if unset.
OPENROUTER_MUSIC_MODEL_LONG=google/lyria-3-pro-preview

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the OpenRouter base URL (default below).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution for OpenRouter rankings (HTTP-Referer / X-Title).
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=
# Output directory for generated audio. Use an ABSOLUTE path for Claude Desktop.
# AUDIO_OUTPUT_DIR=./output
# Default voice preset when generate_voice's `voice` param is omitted.
# One of: alloy | echo | fable | onyx | nova | shimmer
# OPENROUTER_VOICE_DEFAULT=alloy
# Default output audio format when the `format` param is omitted: wav | mp3
# AUDIO_DEFAULT_FORMAT=wav
